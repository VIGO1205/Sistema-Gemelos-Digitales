# Motor IA M-6 - Servicio de Inferencia en Vivo (FastAPI)
# Contenedor ligero: sin Streamlit, solo cargar el modelo ganador y predecir.
# Torch en CPU para reducir tamano de imagen (el Motor IA entrena en CPU igualmente).

FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Herramientas para compilar paquetes que no tienen wheel (statsmodels, pykrige, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends build-essential gcc g++ && rm -rf /var/lib/apt/lists/*

COPY requirements-serving.txt requirements.txt ./

# 1) Torch CPU (mas ligero que el build GPU por defecto)
RUN pip install --no-cache-dir torch==2.14.0 torchvision==0.29.0 --index-url https://download.pytorch.org/whl/cpu && \
    # 2) Resto de dependencias del Motor IA + FastAPI/uvicorn
    pip install --no-cache-dir -r requirements-serving.txt

COPY . .

EXPOSE 8502

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8502/health', timeout=4); sys.exit(0)" || exit 1

CMD ["uvicorn", "serving:app", "--host", "0.0.0.0", "--port", "8502"]
