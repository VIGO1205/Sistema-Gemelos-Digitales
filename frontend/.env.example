# Backend AI Configuration (GROQ)
# The backend proxies all AI chat requests via /api/chat.
# Set your GROQ_API_KEY in backend/.env, NOT here.
# GROQ_MODEL defaults to llama-3.3-70b-versatile

# Backend API Base URL for Frontend. In Vercel, set this to the public HTTPS
# URL of your separately hosted FastAPI service (without a trailing slash).
# Vite embeds this value in the browser bundle at build time; it is not secret.
VITE_API_BASE_URL=http://localhost:8000
